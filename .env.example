# Copy to .env and fill in from your Supabase project:
#   Supabase dashboard → Project Settings → API

# PUBLIC — inlined into the browser bundle by Vite. This is correct:
# the anon key is designed to be shipped to clients, and row-level
# security is what actually protects the data behind it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY — no VITE_ prefix, so Vite never inlines it.
# This key BYPASSES row-level security entirely. Used only by
# scripts/promote-admin.mjs. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
