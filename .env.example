# Copy to .env and fill in from your Supabase project:
#   Supabase dashboard → Project Settings → API

# PUBLIC — inlined into the browser bundle by Vite. This is correct:
# the anon key is designed to be shipped to clients, and row-level
# security is what actually protects the data behind it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY — no VITE_ prefix, so Vite never inlines it.
# This key BYPASSES row-level security entirely. Used only by
# scripts/promote-admin.mjs. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Buy Me a Coffee page handle — the part after buymeacoffee.com/.
# PUBLIC: it ends up in a link members click. Leave it unset and /donate
# falls back to the manual "record a donation" form on its own.
VITE_BMC_USERNAME=

# SERVER ONLY — the signing secret of the Buy Me a Coffee webhook
# (BMC dashboard -> Settings -> Webhooks -> your webhook -> Signing secret).
# Point that webhook at https://<your-domain>/api/bmc-webhook.
# Unset, the webhook route answers 501 and records nothing.
BMC_WEBHOOK_SECRET=

# Web Push. Generate a pair with: npx web-push generate-vapid-keys
# The public key is public by design; the private key must never be exposed.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com

# Shared secret for POST /api/push-dispatch, which sends queued pushes.
# Call it on a schedule (e.g. a Vercel cron) with:
#   Authorization: Bearer <this value>
# Unset, the endpoint refuses to run — it fails closed.
PUSH_DISPATCH_SECRET=

# Public origin, no trailing slash — absolute Open Graph images and sitemap.
VITE_SITE_URL=

# Error monitoring (optional). Unset, the SDK is never downloaded.
VITE_SENTRY_DSN=
